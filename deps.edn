{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}

  ;; harness
  org.clojure/data.json {:mvn/version "2.5.1"}
  org.clojure/tools.cli {:mvn/version "1.1.230"}
  com.github.oshi/oshi-core {:mvn/version "6.6.5"}

  ;; metrics
  io.micrometer/micrometer-core {:mvn/version "1.16.2"}
  io.micrometer/micrometer-registry-prometheus {:mvn/version "1.16.2"}

  ;; logging (clojure.tools.logging -> SLF4J -> logback)
  org.clojure/tools.logging {:mvn/version "1.3.0"}
  ch.qos.logback/logback-classic {:mvn/version "1.5.16"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps  {org.clojure/tools.namespace {:mvn/version "1.5.0"}
                 com.lambdaisland/classpath {:mvn/version "0.5.48"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :build {:extra-deps {io.github.clojure/tools.build {:git/tag "v0.10.6" :git/sha "52cf7d6"}}
          :ns-default build}

  ;; e.g. clj -M:bench example --duration PT5S
  :bench {:main-opts ["-m" "benchy.bench"]}}

 :mvn/repos {"central"        {:url "https://repo1.maven.org/maven2/"}
             "clojars"        {:url "https://clojars.org/repo"}}}
